## 💻 Script Anonymize

> [!IMPORTANT]
> Chạy script này **TRƯỚC** khi đưa data vào luận văn hoặc public repo. Lưu bản gốc riêng, chỉ commit bản đã anonymize.

```python
"""
anonymize_dataset.py
Chạy: python anonymize_dataset.py
Output: thư mục data_anonymized/ chứa các file đã xử lý
"""
import pandas as pd
import hashlib
import os
import re
from pathlib import Path

# ============================================================
# CẤU HÌNH
# ============================================================
OUTPUT_DIR = "data_anonymized"
os.makedirs(OUTPUT_DIR, exist_ok=True)

# Salt ngẫu nhiên - thay đổi mỗi lần chạy để không thể reverse
SALT = "thesis_iuh_2026_unique_salt_change_me"

def hash_value(val, prefix="ID"):
    """Hash giá trị thành mã ẩn danh."""
    if pd.isna(val) or str(val).strip() == "":
        return val
    h = hashlib.sha256(f"{SALT}{val}".encode()).hexdigest()[:8]
    return f"{prefix}_{h}"

def anonymize_name(val, prefix="Person"):
    """Chuyển tên thành mã: Person_a1b2c3d4"""
    return hash_value(val, prefix)

def strip_address_to_district(val):
    """Chỉ giữ lại Quận/District/Region."""
    if pd.isna(val):
        return val
    val = str(val)
    # Singapore postal code → district mapping
    match = re.search(r'Singapore\s+(\d{6})', val)
    if match:
        postal = match.group(1)
        return f"District_{postal[:2]}"
    # Fallback
    return "Address_Redacted"

# ============================================================
# 1. ANONYMIZE FILE CHÍNH: property_cases_enriched.csv
# ============================================================
print("Processing property_cases_enriched.csv...")
df = pd.read_csv("property_cases_enriched.csv")

# Registration Number (CEA) → hash
df['Registration Number'] = df['Registration Number'].apply(
    lambda x: hash_value(x, "REG")
)
# Transaction No → sequential
df['Transaction No'] = [f"TXN_{i+1:06d}" for i in range(len(df))]
# Unit Number → redact
df['Unit Number'] = "REDACTED"

df.to_csv(f"{OUTPUT_DIR}/property_cases_enriched_anon.csv", index=False)
print(f"  ✅ Saved ({len(df)} rows)")

# ============================================================
# 2. ANONYMIZE: property_cases_transactions_enriched.csv
# ============================================================
print("Processing property_cases_transactions_enriched.csv...")
df2 = pd.read_csv("property_cases_transactions_enriched.csv")

df2['Registration Number'] = df2['Registration Number'].apply(
    lambda x: hash_value(x, "REG")
)
df2['Transaction No'] = [f"TXN_{i+1:06d}" for i in range(len(df2))]
df2['Unit Number'] = "REDACTED"

df2.to_csv(f"{OUTPUT_DIR}/property_cases_transactions_enriched_anon.csv", index=False)
print(f"  ✅ Saved ({len(df2)} rows)")

# ============================================================
# 3. ANONYMIZE: rent_df.csv
# ============================================================
print("Processing rent_df.csv...")
df3 = pd.read_csv("rent_df.csv")

# Xóa URL (link trực tiếp listing)
df3 = df3.drop(columns=['url'], errors='ignore')
# Title chứa địa chỉ cụ thể → chỉ giữ project name
df3['title'] = df3['projectName']  # dùng project name thay vì địa chỉ

df3.to_csv(f"{OUTPUT_DIR}/rent_df_anon.csv", index=False)
print(f"  ✅ Saved ({len(df3)} rows)")

# ============================================================
# 4. ANONYMIZE: SNRE-AGENT-LIST.csv (FILE NGUY HIỂM NHẤT)
# ============================================================
AGENT_FILE = "csv_agent_platform/detection/data/raw/SNRE-AGENT-LIST.csv"
if os.path.exists(AGENT_FILE):
    print("Processing SNRE-AGENT-LIST.csv (CRITICAL)...")
    df4 = pd.read_csv(AGENT_FILE)

    # XÓA HOÀN TOÀN các cột cực nhạy cảm
    drop_cols = [
        'NRIC', 'Mobile', 'Personal Email Address', 'Company Email',
        'Address', 'Bank Account Details', 'Birthday DD',
        'Chinese Name', 'Namecard', 'Website', 'Prev Agency'
    ]
    df4 = df4.drop(columns=[c for c in drop_cols if c in df4.columns])

    # Hash các cột tên
    for col in ['NRIC Name', 'PROPER NRIC Name', 'Salesperson Name',
                'Business Name', 'Team Leader Name']:
        if col in df4.columns:
            df4[col] = df4[col].apply(lambda x: anonymize_name(x, "Agent"))

    # Hash CEA Reg
    if 'CEA Reg NO' in df4.columns:
        df4['CEA Reg NO'] = df4['CEA Reg NO'].apply(lambda x: hash_value(x, "REG"))

    # Agent No → sequential
    df4['Agent No'] = range(1, len(df4) + 1)

    os.makedirs(f"{OUTPUT_DIR}/raw", exist_ok=True)
    df4.to_csv(f"{OUTPUT_DIR}/raw/SNRE-AGENT-LIST_anon.csv", index=False)
    print(f"  ✅ Saved ({len(df4)} rows)")

# ============================================================
# 5. GENERIC: Anonymize transaction files with common PII columns
# ============================================================
TRANSACTION_FILES = [
    "csv_agent_platform/detection/data/raw/normal/project_transactions.csv",
    "csv_agent_platform/detection/data/raw/normal/non_project_transactions.csv",
    "csv_agent_platform/detection/data/raw/normal/referral_non_project_transactions.csv",
]

# Cột cần XÓA hoàn toàn
COLS_TO_DROP = [
    'Landlord/Seller Phone Number', 'Tenant/Buyer Phone Number',
    'Landlord/Seller UEN Number', 'Tenant/Buyer UEN Number',
    'Buyer Phone Number', 'Buyer UEN Number',
]

# Cột cần HASH (tên người)
COLS_TO_HASH = [
    'Salesperson Name', 'Referral Name', 'ICB Name', 'ECB Name',
    'ECB Company Name', 'Landlord/Seller Name', 'Tenant/Buyer Name',
    'Buyer Name', 'Billing Name', 'Payee Name', 'Matched Agent Name',
    'Closing Salesperson Name', 'Closing SALESPERSON Name',
    'Billing Party Name', 'ICB Name 2', 'ICB Name 3',
    'ECB Name 2', 'ECB Company Name 2', 'Referral Name 2',
]

# Cột cần strip address
COLS_ADDRESS = [
    'Landlord/Seller Addresss', 'Tenant/Buyer Addresss',
    'Buyer Addresss', 'Billing Address', 'Address',
]

for fpath in TRANSACTION_FILES:
    if os.path.exists(fpath):
        print(f"Processing {os.path.basename(fpath)}...")
        df = pd.read_csv(fpath)

        # Drop
        df = df.drop(columns=[c for c in COLS_TO_DROP if c in df.columns])

        # Hash names
        for col in COLS_TO_HASH:
            if col in df.columns:
                df[col] = df[col].apply(lambda x: anonymize_name(x, "Person"))

        # Strip addresses
        for col in COLS_ADDRESS:
            if col in df.columns:
                df[col] = df[col].apply(strip_address_to_district)

        out_name = os.path.basename(fpath).replace('.csv', '_anon.csv')
        os.makedirs(f"{OUTPUT_DIR}/transactions", exist_ok=True)
        df.to_csv(f"{OUTPUT_DIR}/transactions/{out_name}", index=False)
        print(f"  ✅ Saved ({len(df)} rows)")

print("\n🎉 Anonymization complete! Check:", OUTPUT_DIR)
```

